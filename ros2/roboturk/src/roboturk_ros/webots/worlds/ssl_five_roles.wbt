#VRML_SIM R2025a utf8
IMPORTABLE EXTERNPROTO "../protos/SslRobot.proto"
EXTERNPROTO "../protos/SslBall.proto"
EXTERNPROTO "../protos/SslDivisionBField.proto"

WorldInfo {
  info [ "RoboTurk behavior prototype: acceleration-limited body velocity, ODE contacts, spring dribbler." ]
  basicTimeStep 2
  coordinateSystem "ENU"
  randomSeed 0
  contactProperties [
    ContactProperties {
      material1 "robot" material2 "floor"
      coulombFriction [ 0 ] bounce 0
    }
    ContactProperties {
      material1 "ball" material2 "floor"
      # The backend integrates isotropic carpet traction from measured slip and spin.
      coulombFriction [ 0 ] rollingFriction 0 0 0 bounce 0.1
    }
    ContactProperties {
      material1 "ball" material2 "goal"
      coulombFriction [ 0.6 ] bounce 0.05 bounceVelocity 0.05
    }
  ]
}
DEF CAMERA Viewpoint { orientation -0.577350269 0.577350269 0.577350269 2.094395102 position 0 0 16.5 }
Background { skyColor [ 0.08 0.1 0.14 ] }
DirectionalLight {
  direction -0.35 -0.4 -1
  intensity 0.92
  ambientIntensity 0.26
  castShadows TRUE
}
DEF FIELD SslDivisionBField { }
DEF BALL SslBall { }
DEF BLUE_0 SslRobot { name "BLUE_0" translation -4.18 0 0.075 color 0.05 0.25 0.95 }
DEF BLUE_1 SslRobot { name "BLUE_1" translation -0.6 0 0.075 color 0.05 0.25 0.95 }
DEF BLUE_2 SslRobot { name "BLUE_2" translation -0.8 1.5 0.075 color 0.05 0.25 0.95 }
DEF BLUE_3 SslRobot { name "BLUE_3" translation -1.1 -1.4 0.075 color 0.05 0.25 0.95 }
DEF BLUE_4 SslRobot { name "BLUE_4" translation -2.4 0 0.075 color 0.05 0.25 0.95 }
DEF YELLOW_0 SslRobot { name "YELLOW_0" translation 4.18 0 0.075 color 0.95 0.8 0.05 }
DEF YELLOW_1 SslRobot { name "YELLOW_1" translation 0.6 0 0.075 color 0.95 0.8 0.05 }
DEF YELLOW_2 SslRobot { name "YELLOW_2" translation 0.8 -1.5 0.075 color 0.95 0.8 0.05 }
DEF YELLOW_3 SslRobot { name "YELLOW_3" translation 1.1 1.4 0.075 color 0.95 0.8 0.05 }
DEF YELLOW_4 SslRobot { name "YELLOW_4" translation 2.4 0 0.075 color 0.95 0.8 0.05 }
Robot {
  name "roboturk_supervisor"
  supervisor TRUE
  controller "roboturk_five_roles"
  synchronization TRUE
}
