#VRML_SIM R2025a utf8
EXTERNPROTO "../protos/SslActuatedRobot.proto"
EXTERNPROTO "../protos/SslBall.proto"

WorldInfo {
  info [ "Articulated RoboTurk four-wheel drive and ball actuator bench" ]
  basicTimeStep 2
  randomSeed 0
  coordinateSystem "ENU"
  contactProperties [
    ContactProperties {
      material1 "omniwheel"
      material2 "carpet"
      # The bench applies directional forces from measured shaft slip.
      coulombFriction [ 0 ]
      bounce 0
      softCFM 0.0002
    }
    ContactProperties {
      material1 "ball"
      material2 "carpet"
      coulombFriction [ 0.52 ]
      rollingFriction 0.001 0.001 0
      bounce 0.15
      bounceVelocity 0.12
    }
    ContactProperties {
      material1 "ball"
      material2 "roller"
      coulombFriction [ 1.1 ]
      bounce 0.02
    }
    ContactProperties {
      material1 "ball"
      material2 "striker"
      coulombFriction [ 0.12 ]
      bounce 0.28
      bounceVelocity 0.06
    }
  ]
}
DEF CAMERA Viewpoint { position 0.70 -0.60 0.40 orientation 0.89 0.34 0.31 1.13 fieldOfView 0.75 }
Background { skyColor [ 0.05 0.08 0.11 ] }
DirectionalLight { direction -0.25 -0.65 -1 intensity 2 ambientIntensity 0.6 }
DirectionalLight { direction 0.4 0.5 -1 intensity 0.6 }
Solid {
  translation 0 0 -0.015
  contactMaterial "carpet"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.11 0.29 0.25 roughness 1 metalness 0 }
      geometry Box { size 12 8 0.03 }
    }
  ]
  boundingObject Box { size 12 8 0.03 }
}
